-        const votesSufficient = await __classPrivateFieldGet(this, _LedgerAtomicInterface_instances, "m", _LedgerAtomicInterface_validateVotingWeight).call(this, votesAndBlocks.votes);
+        const admitWithoutQuorum = __classPrivateFieldGet(__classPrivateFieldGet(this, _LedgerAtomicInterface_ledger, "f"), _Ledger_config, "f").admitWithoutQuorum;
+        const votesSufficient = admitWithoutQuorum?.(votesAndBlocks) === true || await __classPrivateFieldGet(this, _LedgerAtomicInterface_instances, "m", _LedgerAtomicInterface_validateVotingWeight).call(this, votesAndBlocks.votes);
         if (votesSufficient !== true) {
