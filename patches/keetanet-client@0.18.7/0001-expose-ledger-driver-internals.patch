Expose the ledger driver internals on the lib default export

Why: a storage driver has to reuse the ledger's own effect and deferral logic
exactly (LedgerStorageBase, computeEffectOfBlocks, computeLedgerEffect,
addTimeStatistic) and mint IdempotentKey values, so it must not port them.
Upstream status: none of these is exported by the package, so the bundle's
webpack modules 5663 (ledger/common) and 7346 (ledger/effects) are reached
through the lib default export (module 8568) and its public type in
client/index.d.ts.
Removal condition: upstream exports these five names, then delete this patch
and import them from the public entry points.

Applies with "patch -p1" from the package root.

--- a/client/index.js
+++ b/client/index.js
@@ -66785,6 +66785,8 @@
 const Initial = __importStar(__webpack_require__(3750));
 const Conversion = __importStar(__webpack_require__(2360));
 const Certificate = __importStar(__webpack_require__(5661));
+const common_1 = __webpack_require__(5663);
+const effects_1 = __webpack_require__(7346);
 exports["default"] = {
     /**
      * The `Account` module provides functionality for managing key pairs
@@ -66794,6 +66796,13 @@
     Block: block_1.default,
     Error: error_1.KeetaNetError,
     Ledger: ledger_1.default,
+    LedgerInternals: {
+        LedgerStorageBase: common_1.LedgerStorageBase,
+        computeEffectOfBlocks: effects_1.computeEffectOfBlocks,
+        computeLedgerEffect: common_1.computeLedgerEffect,
+        addTimeStatistic: common_1.addTimeStatistic,
+        IdempotentKey: ledger_1.IdempotentKey
+    },
     Log: log_1.default,
     Node: node_1.default,
     P2P: p2p_1.default,
--- a/client/index.d.ts
