#!/usr/bin/env bash
set -euo pipefail

package='@keetanetwork/keetanet-client'

fail() {
	echo "fetch-keetanet-client: $*" >&2
	exit 1
}

if [ "$#" -ne 2 ]; then
	echo "usage: fetch-keetanet-client <version> <destination>" >&2
	exit 2
fi
version=$1
destination=$2

# A tag such as "latest" or a range such as "0.18" would resolve to whatever the
# registry says today, so the directory named after it could hold any release.
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || fail "not an exact version: $version"
[ ! -e "$destination" ] || fail "destination already exists: $destination"

mkdir -p "$(dirname "$destination")"
# Beside the destination so the final rename stays on one filesystem.
work=$(mktemp -d "$destination.fetch.XXXXXX")
trap 'rm -rf "$work"' EXIT

# Depending on the npm release, an unknown version is either an E404 failure or
# an empty answer with a zero exit; both mean the version does not exist, as
# opposed to a registry that could not be queried at all.
if ! expected=$(npm view "$package@$version" dist.integrity 2>"$work/view.err"); then
	grep -q 'E404' "$work/view.err" || fail "cannot query the npm registry for $package@$version"
	fail "$package@$version does not exist on the npm registry"
fi
[ -n "$expected" ] || fail "$package@$version does not exist on the npm registry"

mkdir "$work/pack" "$work/extract"
npm pack "$package@$version" --json --pack-destination "$work/pack" >"$work/pack.json" 2>/dev/null ||
	fail "cannot download $package@$version"

actual=$(jq -r '.[0].integrity' "$work/pack.json") || fail "cannot read the integrity of $package@$version"
[ "$actual" = "$expected" ] || fail "integrity mismatch for $package@$version"

# The tarball is only ever read by our extractor, never run.
tar -xzf "$work"/pack/*.tgz \
	-C "$work/extract" --strip-components=1 --no-same-owner --no-same-permissions package ||
	fail "cannot extract $package@$version"

mv "$work/extract" "$destination"
