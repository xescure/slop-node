#!/usr/bin/env python3
"""Captures a Keeta mainnet representative's responses to the node HTTP API.

Usage: capture-api-responses [--only <name>[,<name>...]] <head-state> <output-directory>

Sends one GET request for every GET route of api/openapi.json, and others that
probe how a representative reads malformed parameters and where its pages stop,
to one public mainnet representative, and writes each request with the status,
content type and body of its response to its own JSON file in
<output-directory>, named <name>.json. With --only, only the named
requests are sent, and their files replace those in <output-directory>; the
other files are left as they are. The accounts, tokens and blocks named in the
requests are taken from <head-state>, the state dump of the mainnet head
(conformance/mainnet/head.state.jsonl); the start of a second history page is
the "nextKey" of the first, as the client pages, and the other values taken
from earlier answers are named where they are taken. conformance/API.md
describes the capture.

Only HTTP GET requests are made, one at a time with a pause between them:
nothing is published, no vote is asked for and no peer message is sent. The
statistics-clearing route is a GET that changes the representative's state,
so it is left out. Nothing here runs in the tests, and it needs only the
standard library.
"""

import base64
import collections
import hashlib
import json
import os
import shutil
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

PROGRAM = "capture-api-responses"
API_URL = "https://rep1.main.network.api.keeta.com/api"
USER_AGENT = "slop-node-capture/1"
TIMEOUT_SECONDS = 60
PAUSE_SECONDS = 0.5
PAGE_LIMIT = "2"
# An account's history page holds whole staples, which are large; one per page
# still shows how pages follow each other.
ACCOUNT_HISTORY_LIMIT = "1"
EPOCH = "1970-01-01T00:00:00.000Z"
# A key derived from a fixed test seed, so no mainnet block has touched it.
UNKNOWN_ACCOUNT = "keeta_aabx4z7qrrsongdomou3l6vcyuaovnfo6s3wlm4v3vub6zu4xhte5ntk6qifixa"
# The SHA-256 of nothing is a well-formed hash that no block or certificate has.
UNKNOWN_HASH = hashlib.sha256(b"").hexdigest().upper()
UNKNOWN_IDEMPOTENT_KEY = base64.b64encode(b"slop-node/unknown").decode("ascii")
MALFORMED_HASH = "not-a-hash"
MALFORMED_ACCOUNT = "keeta_not-an-account"
# The ED25519 account whose public key is all zeros, which signs blocks of the
# edge-case staples (conformance/MAINNET.md, section 7); the head state holds
# no ED25519 account.
ZERO_ED25519_ACCOUNT = "keeta_aeaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaazpi2nodu"


def fail(message):
	print(f"{PROGRAM}: {message}", file=sys.stderr)
	sys.exit(1)


# The first byte of an account's public key string names its key type
# [Keeta TS] index.js:61548-61554, 62455-62468.
KEY_TYPE_ECDSA_SECP256K1 = 0
KEY_TYPE_NETWORK = 2
KEY_TYPE_TOKEN = 3
KEY_TYPE_STORAGE = 4
KEY_TYPE_MULTISIG = 7
# The operation types a block carries [Keeta TS] index.js:64636-64646.
OPERATION_SEND = 0
OPERATION_CREATE_IDENTIFIER = 4
# Enough of the network's first staples to hold one of each kind the history
# captures start from.
EARLY_STAPLES_LIMIT = "25"


def key_type(account):
	encoded = account.removeprefix("keeta_").upper()
	return base64.b32decode(encoded + "=" * (-len(encoded) % 8))[0]


class Parameters:
	"""The mainnet accounts, token and block the requests name, chosen by fixed rules from the head state."""

	def __init__(self, records):
		accounts = {}
		heads = {}
		balances = collections.defaultdict(list)
		holders = collections.Counter()
		weights = []
		rows = []
		for record in records:
			kind = record.get("kind")
			if kind == "account":
				accounts[record["account"]] = record
			elif kind == "head":
				heads[record["account"]] = record
			elif kind == "balance":
				balances[record["account"]].append(record)
				holders[record["token"]] += 1
			elif kind == "weight":
				weights.append(record)
			elif kind == "acl":
				rows.append(record)

		def first(description, candidates):
			for candidate in candidates:
				return candidate
			fail(f"the head state has no {description}")

		def of_type(wanted):
			return (account for account in accounts if key_type(account) == wanted)

		# The token most accounts hold is the base token.
		self.token = first("token", (token for token, _ in holders.most_common(1) if key_type(token) == KEY_TYPE_TOKEN))
		self.user = first("keypair account with a chain, a representative and two balances", (
			account for account in of_type(KEY_TYPE_ECDSA_SECP256K1)
			if account in heads and accounts[account]["representative"] is not None and len(balances[account]) >= 2
		))
		self.user_head = heads[self.user]["block"]
		self.network = first("network address with a chain", (account for account in of_type(KEY_TYPE_NETWORK) if account in heads))
		self.multisig = first("multisig account", of_type(KEY_TYPE_MULTISIG))
		self.storage = first("storage account with a chain", (account for account in of_type(KEY_TYPE_STORAGE) if account in heads))
		self.principal = self.multisig
		self.entity = first(f"permission row of {self.multisig} on the base token", (
			row["entity"] for row in rows if row["principal"] == self.principal and row["entity"] == self.token
		))
		self.representative = first("representative", (
			record["representative"] for record in sorted(weights, key=lambda record: -int(record["weight"]))
		))


def read_head_state(path):
	try:
		with open(path, encoding="ascii") as source:
			return [json.loads(line) for line in source]
	except (OSError, ValueError) as error:
		fail(f"cannot read {path}: {error}")


def encode_segment(value):
	# As encodeURIComponent, which the client applies to each path argument.
	return urllib.parse.quote(value, safe="-_.!~*'()")


def fetch(path, query):
	url = API_URL.removesuffix("/api") + path
	if query:
		url = f"{url}?{urllib.parse.urlencode(query)}"
	request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT}, method="GET")
	try:
		with urllib.request.urlopen(request, timeout=TIMEOUT_SECONDS) as response:
			return response.status, response.headers.get("content-type"), response.read()
	except urllib.error.HTTPError as error:
		with error:
			return error.code, error.headers.get("content-type"), error.read()
	except (urllib.error.URLError, OSError) as error:
		fail(f"GET {url} failed: {error}")


def decode_body(content_type, raw):
	text = raw.decode("utf-8")
	if content_type is not None and "json" in content_type:
		try:
			return json.loads(text)
		except ValueError:
			return text
	return text


class Capture:
	def __init__(self, directory, selected):
		"""Sends the requests named in selected, or every request when selected is None."""
		self.directory = directory
		self.selected = selected
		self.names = set()

	def get(self, name, segments, query=None):
		"""
		GETs /api followed by the segments, each encoded as one path segment,
		records the exchange as <name>.json and returns the body; returns None
		for a request that is not selected.
		"""
		if name in self.names:
			fail(f"{name} is captured twice")
		self.names.add(name)
		if self.selected is not None and name not in self.selected:
			return None
		if None in segments or None in (query or {}).values():
			fail(f"{name} pages from a request that is not selected")
		query = dict(sorted((query or {}).items()))
		path = "/api/" + "/".join(encode_segment(segment) for segment in segments)
		time.sleep(PAUSE_SECONDS)
		status, content_type, raw = fetch(path, query)
		body = decode_body(content_type, raw)
		record = {
			"request": {"method": "GET", "path": path, "query": query},
			"status": status,
			"headers": {"content-type": content_type},
			"body": body,
		}
		with open(os.path.join(self.directory, f"{name}.json"), "w", encoding="ascii") as out:
			json.dump(record, out, indent=2, sort_keys=True, ensure_ascii=True)
			out.write("\n")
		print(f"{status} GET {path} {query}", file=sys.stderr)
		return body


def next_key(name, body):
	"""The start of the page after <name>'s, or None when <name> was not requested."""
	if body is None:
		return None
	if not isinstance(body, dict) or not isinstance(body.get("nextKey"), str):
		fail(f"{name} has no nextKey to page from")
	return body["nextKey"]


def page_length(name, body):
	"""How many staples <name>'s history page holds, as a limit, or None when <name> was not requested."""
	if body is None:
		return None
	if not isinstance(body, dict) or not isinstance(body.get("history"), list) or not body["history"]:
		fail(f"{name} has no history to count")
	return str(len(body["history"]))


def last_staple_id(name, body):
	"""
	The blocks hash of the last staple <name> returned, the SHA3-256 of its
	blocks' hashes [Keeta TS] index.js:80126-80135, or None when <name> was
	not requested.
	"""
	if body is None:
		return None
	if not isinstance(body, dict) or not isinstance(body.get("voteStaples"), list) or not body["voteStaples"]:
		fail(f"{name} has no staple to page from")
	blocks = body["voteStaples"][-1]["blocks"]
	return hashlib.sha3_256(b"".join(bytes.fromhex(block["$hash"]) for block in blocks)).hexdigest().upper()


def staple_id(staple):
	"""The blocks hash of a staple, the SHA3-256 of its blocks' hashes [Keeta TS] index.js:80126-80135."""
	return hashlib.sha3_256(b"".join(bytes.fromhex(block["$hash"]) for block in staple["blocks"])).hexdigest().upper()


def signers_of(block):
	"""Every account that signs the block, the signers of a multisig signer and the multisig among them."""
	pending = [block["signer"]]
	signers = []
	while pending:
		signer = pending.pop()
		if isinstance(signer, str):
			signers.append(signer)
		else:
			signers.append(signer[0])
			pending.extend(signer[1])
	return signers


def mentions(staple):
	"""Every account a staple's blocks name: their accounts, their signers and the accounts their operations name."""
	named = set()
	for block in staple["blocks"]:
		named.add(block["account"])
		named.update(signers_of(block))
		for operation in block["operations"]:
			named.update(value for value in operation.values() if isinstance(value, str) and value.startswith("keeta_"))
	return named


def early_staple(name, body, description, wanted):
	"""
	The blocks hash of the first staple of <name>'s bootstrap page that is
	wanted, or None when <name> was not requested.
	"""
	if body is None:
		return None
	if not isinstance(body, dict) or not isinstance(body.get("voteStaples"), list):
		fail(f"{name} has no staples")
	for staple in body["voteStaples"]:
		if wanted(staple):
			return staple_id(staple)
	fail(f"{name} has no {description}")


def only_moves(token):
	"""Whether a staple names the token only as what it sends, to accounts that are not storage."""
	def wanted(staple):
		for block in staple["blocks"]:
			if token in (block["account"], *signers_of(block)):
				return False
			for operation in block["operations"]:
				sent = operation["type"] == OPERATION_SEND and key_type(operation["to"]) != KEY_TYPE_STORAGE
				if any(value == token and not (sent and field == "token") for field, value in operation.items()):
					return False
		return token in mentions(staple)
	return wanted


def only_requires(network):
	"""Whether a staple creates an identifier and names the network address nowhere else."""
	def wanted(staple):
		creates = any(operation["type"] == OPERATION_CREATE_IDENTIFIER for block in staple["blocks"] for operation in block["operations"])
		return creates and network not in mentions(staple)
	return wanted


def multisig_signed(staple):
	return any(not isinstance(block["signer"], str) for block in staple["blocks"])


def first_multisig_member(name, body):
	"""The first account that signs for a multisig in <name>'s bootstrap page, or None when <name> was not requested."""
	if body is None:
		return None
	for staple in body["voteStaples"]:
		for block in staple["blocks"]:
			if not isinstance(block["signer"], str):
				return block["signer"][1][0]
	fail(f"{name} has no block a multisig signs")


def capture(parameters, directory, selected):
	p = parameters
	c = Capture(directory, selected)
	ledger = ["node", "ledger"]

	c.get("node-version", ["node", "version"])
	c.get("node-peers", ["node", "peers"])
	c.get("node-stats", ["node", "stats"])
	c.get("node-bootstrap-votes", ["node", "bootstrap", "votes"], {"start": EPOCH, "limit": "1"})
	c.get("node-bootstrap-votes-without-start", ["node", "bootstrap", "votes"], {"limit": "1"})
	c.get("node-bootstrap-votes-malformed-start", ["node", "bootstrap", "votes"], {"start": "yesterday", "limit": "1"})
	oldest = c.get("node-bootstrap-votes-fractional-limit", ["node", "bootstrap", "votes"], {"start": EPOCH, "limit": "1.5"})

	c.get("ledger-checksum", [*ledger, "checksum"])
	c.get("ledger-representative", [*ledger, "representative"])
	c.get("ledger-representative-of-account", [*ledger, "representative", p.representative])
	c.get("ledger-representatives", [*ledger, "representatives"])
	page = c.get("ledger-history", [*ledger, "history"], {"limit": PAGE_LIMIT})
	c.get("ledger-history-from-start", [*ledger, "history"], {"start": next_key("ledger-history", page), "limit": PAGE_LIMIT})
	c.get("ledger-history-limit-zero", [*ledger, "history"], {"limit": "0"})
	# The staples a bootstrap from the epoch starts with are among the
	# ledger's oldest, so the history after them is a last page shorter than
	# the default limit, and again a last page exactly as long as its limit.
	start = last_staple_id("node-bootstrap-votes-fractional-limit", oldest)
	page = c.get("ledger-history-final-page", [*ledger, "history"], {"start": start})
	limit = page_length("ledger-history-final-page", page)
	page = c.get("ledger-history-full-final-page", [*ledger, "history"], {"start": start, "limit": limit})
	c.get("ledger-history-after-final-page", [*ledger, "history"], {"start": next_key("ledger-history-full-final-page", page), "limit": limit})

	c.get("ledger-block", [*ledger, "block", p.user_head])
	c.get("ledger-block-side", [*ledger, "block", p.user_head], {"side": "side"})
	# The client asks for "both" as it recovers an account [Keeta TS] index.js:59349-59351.
	c.get("ledger-block-both", [*ledger, "block", p.user_head], {"side": "both"})
	c.get("ledger-block-unknown", [*ledger, "block", UNKNOWN_HASH])
	c.get("ledger-block-malformed", [*ledger, "block", MALFORMED_HASH])
	c.get("ledger-block-invalid-side", [*ledger, "block", p.user_head], {"side": "neither"})
	c.get("ledger-block-empty-side", [*ledger, "block", p.user_head], {"side": ""})
	c.get("ledger-block-successor", [*ledger, "block", p.user_head, "successor"])
	c.get("ledger-block-successor-unknown", [*ledger, "block", UNKNOWN_HASH, "successor"])

	c.get("vote", ["vote", p.user_head])
	c.get("vote-side", ["vote", p.user_head], {"side": "side"})
	c.get("vote-unknown", ["vote", UNKNOWN_HASH])
	c.get("vote-malformed", ["vote", MALFORMED_HASH])

	c.get("ledger-accounts", [*ledger, "accounts", ",".join([p.user, p.token, p.network, UNKNOWN_ACCOUNT])])
	c.get("ledger-accounts-malformed", [*ledger, "accounts", ",".join([p.user, MALFORMED_ACCOUNT])])

	account = [*ledger, "account"]
	c.get("ledger-account-keypair", [*account, p.user])
	c.get("ledger-account-token", [*account, p.token])
	c.get("ledger-account-network", [*account, p.network])
	c.get("ledger-account-multisig", [*account, p.multisig])
	c.get("ledger-account-storage", [*account, p.storage])
	c.get("ledger-account-ed25519", [*account, ZERO_ED25519_ACCOUNT])
	c.get("ledger-account-unknown", [*account, UNKNOWN_ACCOUNT])
	c.get("ledger-account-malformed", [*account, MALFORMED_ACCOUNT])
	c.get("ledger-account-head", [*account, p.user, "head"])
	c.get("ledger-account-head-unknown", [*account, UNKNOWN_ACCOUNT, "head"])
	c.get("ledger-account-chain", [*account, p.user, "chain"], {"limit": PAGE_LIMIT})
	page = c.get("ledger-account-chain-from-start", [*account, p.user, "chain"], {"start": p.user_head, "limit": PAGE_LIMIT})
	end = next_key("ledger-account-chain-from-start", page)
	c.get("ledger-account-chain-fractional-limit", [*account, p.user, "chain"], {"start": p.user_head, "limit": "1.5"})
	c.get("ledger-account-chain-to-end", [*account, p.user, "chain"], {"start": p.user_head, "end": end})
	c.get("ledger-account-chain-full-page-at-end", [*account, p.user, "chain"], {"start": p.user_head, "end": end, "limit": PAGE_LIMIT})
	page = c.get("ledger-account-history", [*account, p.user, "history"], {"limit": ACCOUNT_HISTORY_LIMIT})
	start = next_key("ledger-account-history", page)
	c.get("ledger-account-history-from-start", [*account, p.user, "history"], {"start": start, "limit": ACCOUNT_HISTORY_LIMIT})
	c.get("ledger-account-history-start", [*account, p.user, "history", "start", start], {"limit": ACCOUNT_HISTORY_LIMIT})
	c.get("ledger-account-history-unknown-start", [*account, p.user, "history"], {"start": UNKNOWN_HASH, "limit": ACCOUNT_HISTORY_LIMIT})
	# The second staple of the network, which a bootstrap from the epoch
	# returns second, holds no block of the user's, so it is no entry of the
	# user's history.
	c.get("ledger-account-history-start-elsewhere", [*account, p.user, "history"], {"start": last_staple_id("node-bootstrap-votes-fractional-limit", oldest), "limit": ACCOUNT_HISTORY_LIMIT})
	# Which accounts' history lists a staple: a representative refuses a page
	# from a staple of which the account is no entry. The staples are the
	# first of each kind among the network's first staples.
	early = c.get("node-bootstrap-votes-early", ["node", "bootstrap", "votes"], {"start": EPOCH, "limit": EARLY_STAPLES_LIMIT})
	moved = early_staple("node-bootstrap-votes-early", early, f"staple that only moves {p.token}", only_moves(p.token))
	c.get("ledger-account-history-start-token-moved", [*account, p.token, "history", "start", moved], {"limit": ACCOUNT_HISTORY_LIMIT})
	created = early_staple("node-bootstrap-votes-early", early, f"staple that creates an identifier and names {p.network} nowhere", only_requires(p.network))
	c.get("ledger-account-history-start-network-required", [*account, p.network, "history", "start", created], {"limit": ACCOUNT_HISTORY_LIMIT})
	signed = early_staple("node-bootstrap-votes-early", early, "staple a multisig signs", multisig_signed)
	c.get("ledger-account-history-start-multisig-member", [*account, first_multisig_member("node-bootstrap-votes-early", early), "history", "start", signed], {"limit": ACCOUNT_HISTORY_LIMIT})
	c.get("ledger-account-history-limit-zero", [*account, p.user, "history"], {"limit": "0"})
	c.get("ledger-account-history-limit-fractional", [*account, p.user, "history"], {"limit": "1.5"})
	c.get("ledger-account-history-limit-below-one", [*account, p.user, "history"], {"limit": "0.5"})
	c.get("ledger-account-history-limit-negative", [*account, p.user, "history"], {"limit": "-1"})
	c.get("ledger-account-history-limit-empty", [*account, p.user, "history"], {"limit": ""})
	c.get("ledger-account-history-limit-not-a-number", [*account, p.user, "history"], {"limit": "abc"})
	c.get("ledger-account-balance", [*account, p.user, "balance"])
	c.get("ledger-account-balance-of-token", [*account, p.user, "balance", p.token])
	c.get("ledger-account-acl", [*account, p.principal, "acl"])
	c.get("ledger-account-acl-of-entities", [*account, p.principal, "acl", p.entity])
	c.get("ledger-account-acl-granted", [*account, p.token, "acl", "granted"])
	c.get("ledger-account-acl-additional", [*account, p.principal, "acl", "additional"])
	c.get("ledger-account-acl-additional-of-entities", [*account, p.principal, "acl", "additional", p.entity])
	c.get("ledger-account-certificates", [*account, p.user, "certificates"])
	c.get("ledger-account-certificate-unknown", [*account, p.user, "certificates", UNKNOWN_HASH])
	c.get("ledger-account-pending", [*account, p.user, "pending"])
	c.get("ledger-account-idempotent-unknown", [*account, p.user, "idempotent", UNKNOWN_IDEMPOTENT_KEY])
	return c.names


def parse_arguments(arguments):
	"""The selected request names, or None for all of them, the head state and the output directory."""
	selected = None
	if len(arguments) == 4 and arguments[0] == "--only":
		selected = set(arguments[1].split(","))
		arguments = arguments[2:]
	if len(arguments) != 2:
		print(f"usage: {PROGRAM} [--only <name>[,<name>...]] <head-state> <output-directory>", file=sys.stderr)
		sys.exit(2)
	return selected, arguments[0], arguments[1].rstrip("/")


def main():
	selected, head_state, output = parse_arguments(sys.argv[1:])
	parameters = Parameters(read_head_state(head_state))
	if selected is not None:
		if not os.path.isdir(output):
			fail(f"{output} must already hold a capture for --only to replace files in")
		# Selecting nothing sends nothing and yields every request's name.
		unknown = selected - capture(parameters, output, set())
		if unknown:
			fail(f"no request is named {', '.join(sorted(unknown))}")
	# Beside the output, so a failed capture leaves the previous one whole and
	# the final renames stay on one filesystem.
	partial = f"{output}.partial"
	previous = f"{output}.previous"
	shutil.rmtree(partial, ignore_errors=True)
	os.makedirs(partial)
	capture(parameters, partial, selected)
	if selected is not None:
		for name in sorted(selected):
			os.replace(os.path.join(partial, f"{name}.json"), os.path.join(output, f"{name}.json"))
		os.rmdir(partial)
		return
	shutil.rmtree(previous, ignore_errors=True)
	if os.path.exists(output):
		os.rename(output, previous)
	os.rename(partial, output)
	shutil.rmtree(previous, ignore_errors=True)


if __name__ == "__main__":
	main()
